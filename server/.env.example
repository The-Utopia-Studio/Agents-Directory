# ── Agents Directory loop service ─────────────────────────────────────
# Copy to .env and fill in. Everything works with the defaults below
# (no external accounts needed) — swap providers only when you're ready.

PORT=8790
# Local default. On Railway this MUST be exactly /data — the documented
# volume mount path. Any other value (including /tmp) is rejected at boot
# so persistence cannot be redirected to arbitrary ephemeral storage.
# Attach a Volume mounted at /data; the process also refuses to start if
# that path is missing or unwritable.
DATA_DIR=./data
CORS_ORIGIN=*

# Optional shared secret for the public Railway URL. When set, every route
# except GET /api/health (and OPTIONS preflight) requires:
#   Authorization: Bearer <API_TOKEN>
# When unset/empty, auth is skipped — local dev and zero-secrets deploys
# behave exactly as before. Set the same value in the front-end via
# window.DIRECTORY_API_TOKEN or localStorage.directory_api_token.
API_TOKEN=

# ── Native skill runtime ─────────────────────────────────────────────
# Selected by RUNTIME_PROVIDER. Must match each live artifact's
# runtime_provider frontmatter (A7/A9 declare openai / gpt-5.6-terra).
# Server-side only: never expose these values to the browser.
RUNTIME_PROVIDER=openai
OPENAI_API_KEY=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
ANTHROPIC_API_KEY=

CLERK_JWT_ISSUER_DOMAIN=
CLERK_JWT_AUDIENCE=convex

# Convex authority writes (state B). Server-only deploy key; never browser.
# Recorded actor: issuer service:agents-directory / subject agents-directory-loop.
CONVEX_URL=
CONVEX_DEPLOY_KEY=

# ── Observability provider ───────────────────────────────────────────
# local    — file-based traces, zero setup (default)
# langfuse — real Langfuse ingestion + query
OBS_PROVIDER=local
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Free-text reason attached to a run's star rating. Stored on the feedback
# record only, never on the trace. Set to false to accept ratings only.
FEEDBACK_NOTES=true
FEEDBACK_NOTES_MAX_CHARS=2000

# ── Self-improvement optimizer ───────────────────────────────────────
# heuristic — reflective, offline, no external calls (default)
# gepa      — real GEPA/DSPy reflective prompt evolution
OPTIMIZER=heuristic
# One of GEPA_ENDPOINT (HTTP job) or GEPA_CMD (local CLI) enables the gepa adapter.
GEPA_ENDPOINT=
GEPA_CMD=
GEPA_MODEL=claude-opus-4-8
GEPA_BUDGET=10

# ── Verifier (the checker in the maker/checker split) ────────────────
# heuristic — offline skeptic (default)
# llm       — a real second model grades the proposal (needs VERIFIER_ENDPOINT)
VERIFIER=heuristic
VERIFIER_ENDPOINT=
VERIFIER_MODEL=claude-opus-4-8

# ── Loop / Automations (the heartbeat) ───────────────────────────────
# The scheduler is OFF by default. Turn it on to run cycles automatically;
# in production prefer cron / GitHub Actions so it survives restarts.
LOOP_ENABLED=false
# e.g. 3600000 for hourly; 0 = manual trigger only
LOOP_INTERVAL_MS=0
# agents scoring below this get triaged
LOOP_LOW_SCORE=70
# per cycle
LOOP_MAX_JOBS=3
# token-cost ceiling per cycle (Osmani's caveat)
LOOP_BUDGET_USD=1
LOOP_COST_PER_JOB=0.05
LOOP_AUTOAPPLY=false
# must be false or unset; true aborts boot

# ── Memory / Context (the fourth pillar) ─────────────────────────────
# local       — file-backed, token-overlap ranking, zero setup (default)
# supermemory — RECOMMENDED: agent memory layer, REST ingest + search
# activeloop  — Deep Lake tensor DB (use the Utopia org); query-first, BYO embeddings
MEMORY_PROVIDER=local
MEMORY_TOP_K=5

# supermemory (https://api.supermemory.ai)
SUPERMEMORY_API_KEY=
SUPERMEMORY_BASE_URL=https://api.supermemory.ai

# activeloop (Utopia org) — set ORG + TOKEN; search needs EMBED_ENDPOINT;
# ingest needs a deeplake writer sidecar (ACTIVELOOP_INGEST_ENDPOINT).
ACTIVELOOP_TOKEN=
ACTIVELOOP_ORG=
ACTIVELOOP_DATASET=agent_memory
ACTIVELOOP_BASE_URL=https://app.activeloop.ai/api/query/v1
EMBED_ENDPOINT=
ACTIVELOOP_INGEST_ENDPOINT=
