# Keep shared authority deployments out of committed defaults.
CONVEX_URL=

# Vercel build input for the browser sign-in surface. This is a publishable
# `pk_…` Clerk key, not a Clerk secret key or JWT.
CLERK_PUBLISHABLE_KEY=

# Public Clerk issuer trusted by convex/auth.config.ts. Configure the same
# value on each Convex deployment; this is not a secret.
CLERK_JWT_ISSUER_DOMAIN=https://valid-collie-71.clerk.accounts.dev
CLERK_JWT_AUDIENCE=convex

# Loop → Convex evidence writes (state B). Deploy key is server-only; never
# put it in the browser. Recorded actor is service:agents-directory / agents-directory-loop.
# State D (intended): short-lived JWTs from that issuer, verified by Convex.
CONVEX_DEPLOY_KEY=
